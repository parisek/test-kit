{
  "name": "@parisek/test-kit",
  "version": "1.3.1",
  "private": true,
  "description": "Testing and comparison tool for sites: pairs of runs, pluggable checks, one viewer, one query interface for agents.",
  "type": "module",
  "bin": {
    "test-kit": "bin/cli.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./compat/selection": "./src/compat/selection.js",
    "./compat/harvest": "./src/compat/harvest-plan.js",
    "./packs": "./src/packs/index.js",
    "./packs/a11y": "./src/packs/a11y/index.js",
    "./packs/a11y/runner": "./src/packs/a11y/runner.js",
    "./packs/swiper": "./src/packs/versioned/swiper.js",
    "./packs/lint": "./src/packs/lint/index.js",
    "./packs/lint/runner": "./src/packs/lint/runner.js",
    "./eslint": "./src/eslint/index.js",
    "./stylelint": "./src/stylelint/index.cjs"
  },
  "files": [
    "bin",
    "src",
    "viewer",
    "templates",
    "THIRD_PARTY_NOTICES.txt"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/parisek/test-kit.git"
  },
  "scripts": {
    "test": "node --test",
    "test:viewer": "npm --prefix frontend test",
    "build:viewer": "npm --prefix frontend run build",
    "check:viewer": "node scripts/check-viewer-build.mjs",
    "demo": "node scripts/demo.mjs",
    "demo:perf": "node scripts/demo-perf.mjs"
  },
  "peerDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": ">=1.49",
    "axe-core": "^4.10.0",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "lighthouse": "^13.5.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript-eslint": "^8.70.0",
    "vue-eslint-parser": "^10.4.1"
  },
