{
  "name": "@parisek/test-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Testing and comparison tool for sites: pairs of runs, pluggable checks, one viewer, one query interface for agents.",
  "type": "module",
  "bin": {
    "test-kit": "bin/cli.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./compat/selection": "./src/compat/selection.js"
  },
  "files": [
    "bin",
    "src",
    "viewer",
    "templates",
    "THIRD_PARTY_NOTICES.txt"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/parisek/test-kit.git"
  },
  "scripts": {
    "test": "node --test",
    "test:viewer": "npm --prefix frontend test",
    "build:viewer": "npm --prefix frontend run build",
    "check:viewer": "node scripts/check-viewer-build.mjs",
    "demo": "node scripts/demo.mjs"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.49"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "dependencies": {
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0"
  },
  "license": "MIT"
}
